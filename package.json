{
  "name": "hotel-sca-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Hotel SCA reservation information system - Supabase backend and database foundation",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local --schema public > src/shared/types/database.generated.ts",
    "db:lint": "supabase db lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.12",
    "eslint": "^9.39.2",
    "prettier": "^3.8.4",
    "supabase": "^3.0.0",
    "tsx": "^4.21.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^5.1.0"
  }
}
