# ---------------------------------------------------------------------------
# Hotel SCA - environment template
# Copy to .env and fill with values from `npx supabase status` (local)
# or Supabase Dashboard > Project Settings > API (hosted).
# NEVER commit .env. NEVER expose SUPABASE_SERVICE_ROLE_KEY to a browser.
# ---------------------------------------------------------------------------

# Server-side / scripts / tests
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Browser-exposed values (Next.js). Only the anon key belongs here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Browser-exposed values (Vite/React). Use these OR the NEXT_PUBLIC pair.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Integration test project (separate from production). Leave blank to skip.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
